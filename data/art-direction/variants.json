{
  "variantSystem": {
    "description": "4 mood variants per archetype. Variants change atmosphere via CSS filters only — zone positions never change. Each site card has a default variant based on narrative context.",
    "cssApplication": "Applied as a CSS filter on the cinemagraph background element + an optional gradient overlay div."
  },
  "baseVariants": [
    {
      "id": "dawn",
      "name": "Dawn",
      "time": "Early morning",
      "cssFilter": "brightness(0.9) saturate(0.8) sepia(0.15)",
      "overlay": "linear-gradient(180deg, rgba(255,160,80,0.08) 0%, rgba(255,120,40,0.12) 100%)",
      "particleType": "mist-slow",
      "feel": "Soft, hopeful, waking world. Mist burning off."
    },
    {
      "id": "day",
      "name": "Day",
      "time": "Midday",
      "cssFilter": "brightness(1.0) contrast(1.05)",
      "overlay": null,
      "particleType": null,
      "feel": "Clear, neutral, full visibility. The world as it is."
    },
    {
      "id": "dusk",
      "name": "Dusk",
      "time": "Evening",
      "cssFilter": "brightness(0.75) saturate(1.2) hue-rotate(-10deg)",
      "overlay": "linear-gradient(180deg, rgba(200,100,40,0.1) 0%, rgba(120,40,80,0.15) 100%)",
      "particleType": "ember-firefly",
      "feel": "Golden hour fading to purple. Warmth draining. Beautiful but ominous."
    },
    {
      "id": "night",
      "name": "Night",
      "time": "After dark",
      "cssFilter": "brightness(0.4) saturate(0.5) contrast(1.3)",
      "overlay": "linear-gradient(180deg, rgba(20,30,60,0.25) 0%, rgba(10,15,35,0.35) 100%)",
      "particleType": "moonbeam-shafts",
      "feel": "Cold, tense, limited visibility. Shadows deepen. Danger."
    }
  ],
  "archetypeVariantNames": {
    "open-field": {
      "dawn": "Morning Mist",
      "day": "High Noon",
      "dusk": "Golden Hour",
      "night": "Moonlit Plains"
    },
    "city": {
      "dawn": "First Light",
      "day": "Market Day",
      "dusk": "Lamplighter",
      "night": "Curfew"
    },
    "underground": {
      "dawn": "Faint Torchlight",
      "day": "Lantern Bright",
      "dusk": "Ember Glow",
      "night": "Deep Darkness"
    },
    "forest": {
      "dawn": "Misty Canopy",
      "day": "Dappled Light",
      "dusk": "Amber Glade",
      "night": "Dark Wood"
    },
    "water": {
      "dawn": "River Mist",
      "day": "Clear Current",
      "dusk": "Sunset Reflection",
      "night": "Moonwater"
    },
    "mountain": {
      "dawn": "Alpenglow",
      "day": "Summit Clear",
      "dusk": "Last Light on Stone",
      "night": "Starlit Peak"
    },
    "fortress": {
      "dawn": "Watch Before Dawn",
      "day": "Garrison Noon",
      "dusk": "Siege Dusk",
      "night": "Night Assault"
    },
    "sanctuary": {
      "dawn": "Silver Dawn",
      "day": "Golden Afternoon",
