  "archetypeVariantOverrides": {
    "underground": {
      "_note": "Underground has no real time-of-day. Variants control light SOURCE intensity instead.",
      "dawn": { "cssFilter": "brightness(0.35) saturate(0.4) sepia(0.2)", "feel": "Barely any light. Distant glow." },
      "day": { "cssFilter": "brightness(0.55) saturate(0.6) contrast(1.1)", "feel": "Torches lit. Visible but confined." },
      "dusk": { "cssFilter": "brightness(0.45) saturate(0.8) sepia(0.1) hue-rotate(10deg)", "feel": "Ember glow. Warm orange from dying fires." },
      "night": { "cssFilter": "brightness(0.2) saturate(0.3) contrast(1.4)", "feel": "Near-total darkness. Only the faintest light." }
    },
    "dark-domain": {
      "_note": "Dark Domain has corrupted light. No clean sunlight ever. Variants control the corruption color.",
      "dawn": { "cssFilter": "brightness(0.5) saturate(0.6) sepia(0.3)", "overlay": "linear-gradient(180deg, rgba(100,80,40,0.15) 0%, rgba(60,40,20,0.2) 100%)" },
      "day": { "cssFilter": "brightness(0.6) saturate(0.5) contrast(1.1) hue-rotate(5deg)", "overlay": "linear-gradient(180deg, rgba(120,100,40,0.1) 0%, rgba(80,60,20,0.15) 100%)" },
      "dusk": { "cssFilter": "brightness(0.5) saturate(1.0) hue-rotate(-15deg)", "overlay": "linear-gradient(180deg, rgba(180,50,20,0.15) 0%, rgba(100,20,10,0.25) 100%)" },
      "night": { "cssFilter": "brightness(0.25) saturate(0.3) contrast(1.5)", "overlay": "linear-gradient(180deg, rgba(10,5,15,0.35) 0%, rgba(5,0,10,0.45) 100%)" }
    }
  }
